# Reference illustration — secrets for the solo topology.
#
# In a real deployment `phoebe init` scaffolds this file at the runtime root
# next to phoebe.config.ts; you copy it to `.env` and fill in the blanks. `.env`
# is gitignored and never committed — only this `.example` is.
#
# GH_TOKEN is required: every `gh` call in the engine reads it, and `phoebe
# boot` uses it to check the engine out from GitHub. Set the ONE provider key
# that matches your `defaultProvider` (or `PHOEBE_AGENT` at runtime).
#
# Which engine version runs is NOT set here — it is `engine.ref` in
# phoebe.config.ts, which `boot` re-reads while the container runs.

# --- Required ---
GH_TOKEN=

# --- Provider keys (set the one you use) ---
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
OPENAI_KEY=

# --- Runtime toggles (optional) ---
# PHOEBE_AGENT=claude
# PHOEBE_MODEL=claude-sonnet-4-6
# PHOEBE_POLL_INTERVAL_MS=300000
