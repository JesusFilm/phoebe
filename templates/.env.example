# Phoebe environment — scaffolded by `phoebe init`. Copy to `.env` and fill in.
#
# GH_TOKEN is required; every `gh` call in the engine reads it, and `phoebe
# boot` uses it to check the engine out from GitHub. The provider key is
# required only for whichever agent you actually run — set the one that matches
# your `defaultProvider` (or `PHOEBE_AGENT` at runtime).
#
# Which engine version runs is NOT set here: it is `engine.ref` in
# phoebe.config.ts, which `boot` re-reads while the container runs.

# --- Required (supervisor: shared git credential helper + engine checkout) ---
GH_TOKEN=

# --- GitHub App arm (alternative to per-tenant GH_TOKEN) ---
# Set BOTH variables to have boot mint a per-tenant installation token from the
# App instead of reading each tenant's GH_TOKEN. App arm is available in both
# solo and workspace deployments.
# The private key must be base64-encoded as a single line:
#   Linux:  base64 -w0 your-app-key.pem
#   macOS:  base64 your-app-key.pem
# Never supply a file path — a mounted key file is readable by every tenant.
# PHOEBE_GH_APP_ID=
# PHOEBE_GH_APP_PRIVATE_KEY=

# --- Provider keys (set the one you use) ---
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
OPENAI_KEY=

# --- Multiple Phoebe containers on one host (usually not needed) ---
# One container can serve many repos as tenants (a workspace root and its
# declared children), so you rarely need a second instance. If you do run
# more than one Phoebe container here, set this uniquely per instance — otherwise
# they share one phoebe-data volume and work each other's clones.
# COMPOSE_PROJECT_NAME=phoebe-your-deployment

# --- Runtime toggles (optional) ---
# PHOEBE_AGENT=claude
# PHOEBE_MODEL=claude-sonnet-4-6
# PHOEBE_POLL_INTERVAL_MS=300000
# How often `boot` checks the config and the tracked engine ref (default 60000).
# PHOEBE_RECONCILE_INTERVAL_MS=60000

# --- Local engine checkout (compose.local.yml only, development) ---
# PHOEBE_ENGINE_MOUNT=/path/to/phoebe
