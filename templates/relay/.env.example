# The relay's environment — scaffolded by `phoebe relay init`. Copy to `.env`
# beside compose.yml and fill it in. `.env` is gitignored; this file is not, so
# keep the secret out of it.
#
# These four are the relay's whole configuration (#506 §9). There is no
# relay.config.ts: the port, the heartbeat interval, the dark threshold and the
# pairing-token lifetime are constants in the code, because an operator who
# tunes them is making the fleet's timing disagree with the relay's.

# The public hostname this relay answers on — no scheme, no path. It has to
# resolve to this host before the first `docker compose up`: Caddy gets the
# certificate for this exact name, and Google's redirect URI is built from it.
RELAY_HOST=

# The Google "Web application" OAuth client. One Google Cloud project, no
# billing account, no verification — `openid` and `email` are non-sensitive
# scopes. Keep the project in Testing with only your account as a test user.
# The client's one authorized redirect URI is
# https://<RELAY_HOST>/auth/google/callback. See docs/relay.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in, comma-separated, merged into the allowlist at every start and
# never written to it — so editing this line and restarting is the way out of a
# lockout.
#
# Blank is an answer, and a consequential one: it means nobody is seeded and
# whoever reaches the URL first and signs in claims this relay. Fill it in
# before the relay is reachable and that window never opens.
ALLOWED_EMAILS=

# --- More than one compose project on this host (usually not needed) ---
# Set this if the default `phoebe-relay` collides with something else here.
# COMPOSE_PROJECT_NAME=phoebe-relay
