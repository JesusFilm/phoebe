# Per-tenant secrets for JesusFilm/phoebe — copy to `.env` and fill in.
#
# Read ONLY by this tenant's engine child: the supervisor builds each child's
# env deny-by-default from an allowlist plus THIS file, so no other tenant's
# secrets — and not the deployment-root GH_TOKEN — are ever visible here (#61).
# `.env` is gitignored; never commit it.

# --- Required: this tenant authenticates every `gh`/git call with its own token ---
GH_TOKEN=

# --- Provider key: this tenant's defaultProvider is `cursor` ---
CURSOR_API_KEY=
