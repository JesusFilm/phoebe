# Per-tenant secrets for JesusFilm/youtube-studio — copy to `.env` and fill in.
#
# Read ONLY by this tenant's engine child (#61) — see the phoebe tenant's
# .env.example for the isolation model. `.env` is gitignored; never commit it.

# --- Required: this tenant authenticates every `gh`/git call with its own token ---
GH_TOKEN=

# --- Provider key: this tenant's defaultProvider is `claude` ---
ANTHROPIC_API_KEY=
