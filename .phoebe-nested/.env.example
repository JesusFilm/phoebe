# Deployment-root environment for the nested dogfood — copy to `.env`, fill in.
#
# In nested mode the real per-tenant secrets live in repos/<owner>/<repo>/.env
# (one GH_TOKEN + provider key each). This root file holds only what the
# SUPERVISOR needs: a token to install the shared git credential helper. It is
# scrubbed out of every tenant child's env (#61), so it is never what a tenant
# pushes with — each tenant uses its own token from its own .env.

# --- Required (supervisor: installs the shared git credential helper) ---
GH_TOKEN=

# --- Fleet knobs (optional) ---
# Cap on concurrent work units across ALL tenants (#59). 1 = tenants take turns.
# PHOEBE_MAX_CONCURRENT_AGENTS=1
# How often boot re-scans tenants + the shared engine (defaults to 10000 here).
# PHOEBE_RECONCILE_INTERVAL_MS=10000
