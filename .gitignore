node_modules/
.env
*.log
.DS_Store
.vite/

# Claude Code's per-user local settings (permissions, etc.). Untracked and
# machine-generated, so it may not be prettier-clean — keep it out of `vp check`'s
# format/lint scan, which honors .gitignore. See #18.
.claude/settings.local.json

# Claude Code's git worktrees. Each is a full checkout of this repo at some other
# commit, so leaving them visible makes `vp check`/lint/typecheck/test scan the
# whole tree N extra times — and flag formatting on files that aren't ours to fix.
.claude/worktrees/

# The console's build (apps/console -> console/). It is published — the root
# package's `files` lists it, which is how `phoebe relay serve` finds the pages
# inside the one installed package — but it is generated, so it is not committed.
# `vp run -r build` writes it; release.yml runs that before `changeset publish`.
/console/
