# Phoebe environment — copy to `.env` and fill in.
#
# GH_TOKEN is required; every `gh` call in the engine reads it. The provider
# key is required only for whichever agent you actually run — set the one that
# matches your `defaultProvider` (or `PHOEBE_AGENT` at runtime).
#
# There is no engine version pin here: the dogfood runs the engine from this
# working tree (`engine: { source: "local" }` in phoebe.config.ts).

# --- Required ---
GH_TOKEN=

# --- Provider keys (set the one you use) ---
# This deployment's defaultProvider is "claude" running under a Pro/Max
# *subscription*, so CLAUDE_CODE_OAUTH_TOKEN is the required one — compose
# refuses to start without it. Mint it with `node scripts/hoist-claude-login.mjs`
# (which writes it here for you); see docs/claude-subscription-auth.md.
CLAUDE_CODE_OAUTH_TOKEN=
# Only needed if you switch this deployment back to API-key billing by pointing
# `providerEnv.claude` at ANTHROPIC_API_KEY, or run another provider.
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
OPENAI_KEY=

# --- Runtime toggles (optional) ---
# PHOEBE_AGENT=claude
# PHOEBE_MODEL=claude-opus-5
# Reasoning effort for the active provider: low | medium | high | xhigh | max.
# The config pins "low" for claude; this overrides it for one run.
# PHOEBE_EFFORT=high
# PHOEBE_POLL_INTERVAL_MS=300000
# How often `boot` re-checks the config (compose defaults this to 10000 here).
# PHOEBE_RECONCILE_INTERVAL_MS=10000
