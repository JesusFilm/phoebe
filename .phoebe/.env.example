# Phoebe environment — copy to `.env` and fill in.
#
# GH_TOKEN is required; every `gh` call in the engine reads it. The provider
# key is required only for whichever agent you actually run — set the one that
# matches your `defaultProvider` (or `PHOEBE_AGENT` at runtime).
#
# There is no engine version pin here: the dogfood runs the engine from this
# working tree (`engine: { source: "local" }` in phoebe.config.ts).

# --- Required ---
GH_TOKEN=

# --- Provider keys (set the one you use) ---
# This deployment's defaultProvider is "claude" running through a CLIProxyAPI
# gateway, so ANTHROPIC_AUTH_TOKEN is the required one: the gateway's access
# key, which phoebe.config.ts names in `providerEnv.claude`. The gateway's URL
# goes in ../claude-home/settings.json (copy claude-home.example), not here.
# Left empty, every unit fails with "Not logged in · Please run /login".
ANTHROPIC_AUTH_TOKEN=
# Only needed if you point `providerEnv.claude` at one of these instead: a
# Pro/Max subscription token (mint it with `node scripts/hoist-claude-login.mjs`,
# see docs/claude-subscription-auth.md), or an API key for pay-as-you-go
# billing. Leave both empty otherwise.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Other providers.
CURSOR_API_KEY=
OPENAI_KEY=

# --- Sentry intake pipeline (required: phoebe.config.ts declares the sentry kind) ---
# A Sentry auth token with the event:read scope on the jesusfilm-rb org
# (Sentry → Settings → Auth Tokens). Read only by the intake pipeline's child;
# without it that pipeline refuses to boot and the work pipeline is unaffected.
SENTRY_AUTH_TOKEN=

# --- Dependencies pipeline (nothing required) ---
# phoebe.config.ts declares the dependency-updates, dependency-security and
# dependencies kinds. They read deps.dev and OSV without a key and run Renovate
# with no token, so they need nothing here. Tune them in phoebe.config.ts.

# --- Runtime toggles (optional) ---
# PHOEBE_AGENT=claude
# PHOEBE_MODEL=claude-opus-5-5
# Reasoning effort for the active provider: low | medium | high | xhigh | max.
# The config pins "low" for claude; this overrides it for one run.
# PHOEBE_EFFORT=high
# PHOEBE_POLL_INTERVAL_MS=300000
# How often `boot` re-checks the config (compose defaults this to 10000 here).
# PHOEBE_RECONCILE_INTERVAL_MS=10000
